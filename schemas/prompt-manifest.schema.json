{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktron.local/schemas/prompt-manifest.schema.json",
  "title": "Desktron Prompt Semantic Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "capabilities", "segments"],
  "properties": {
    "version": { "const": 2 },
    "kind": { "const": "desktron-prompt-manifest" },
    "capabilities": { "const": "prompt.capabilities" },
    "segments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "engine": { "enum": ["claude", "codex", "pi"] },
    "runtime": { "enum": ["native", "shepherd"] },
    "carrier": { "enum": ["system_append", "system_snapshot", "developer_instructions", "application_context", "user_hidden_context", "user_prefix", "native_context"] },
    "target": { "enum": ["claude-native", "claude-shepherd", "codex-native", "codex-shepherd", "pi-native", "pi-shepherd"] },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/engine" } },
        "runtimes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/runtime" } },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/target" } }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "carrier": { "$ref": "#/$defs/carrier" },
        "cadence": { "enum": ["binding", "turn", "conversation_start", "engine_entry", "on_change", "native"] },
        "status": { "enum": ["current", "planned", "external"] },
        "notes": { "type": "string" }
      }
    },
    "deliveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "allOf": [{ "$ref": "#/$defs/delivery" }],
          "required": ["carrier", "cadence", "status"]
        },
        "overrides": {
          "type": "object",
          "propertyNames": { "enum": ["claude", "codex", "pi", "native", "shepherd", "claude-native", "claude-shepherd", "codex-native", "codex-shepherd", "pi-native", "pi-shepherd"] },
          "additionalProperties": { "$ref": "#/$defs/delivery" }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "refresh", "title", "status", "owner", "source", "lifecycle", "priority", "max_chars", "sensitivity", "history", "targets", "delivery"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "refresh": { "enum": ["repository", "binding", "turn", "conversation_start", "on_change", "native"] },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "review", "external"] },
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "lifecycle": { "enum": ["binding", "turn", "engine_entry", "on_change", "native"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 200000 },
        "sensitivity": { "enum": ["public", "internal", "sensitive"] },
        "history": { "enum": ["exclude", "private", "public-sanitized", "native"] },
        "targets": { "$ref": "#/$defs/selector" },
        "delivery": { "$ref": "#/$defs/deliveryPolicy" },
        "notes": { "type": "string" }
      }
    }
  }
}
