@echo off
rem Desktron launcher entry for Windows: locate the Desk managed Python and hand over to
rem desktron\lib\desk_launcher.py. After installation, ~\.local\bin\desktron.cmd is generated by
rem "desktron prepare" and points at the managed Python directly; this file serves source checkouts.
rem ASCII only: cmd.exe reads batch files in the OEM code page.
setlocal
set "DESK_LAUNCHER=%~dp0..\lib\desk_launcher.py"
if defined DESKTRON_PYTHON if exist "%DESKTRON_PYTHON%" (
  "%DESKTRON_PYTHON%" "%DESK_LAUNCHER%" %*
  exit /b %ERRORLEVEL%
)
set "DESK_PY="
for /d %%D in ("%USERPROFILE%\.local\share\desktron\runtime\python-*-windows-*") do (
  if exist "%%D\python.exe" set "DESK_PY=%%D\python.exe"
)
if defined DESK_PY (
  "%DESK_PY%" "%DESK_LAUNCHER%" %*
  exit /b %ERRORLEVEL%
)
where py >nul 2>nul && (
  py -3 "%DESK_LAUNCHER%" %*
  exit /b %ERRORLEVEL%
)
echo desktron: Desk managed Python not found. Run install.ps1 from the release package, or set DESKTRON_PYTHON. 1>&2
exit /b 1
